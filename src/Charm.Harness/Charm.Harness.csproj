<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Charm.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Charm.Engine\Charm.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- World Structure Pass 1 (Phase 53) inputs: the committed reference csvs and the
         tiny fixture world, copied beside the binary so the suite reads them from
         AppContext.BaseDirectory (the config.json convention). -->
    <None Include="..\..\data\teams.csv" Link="data\teams.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\data\conf.csv" Link="data\conf.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\worlds\fixture-tiny.world.json" Link="worlds\fixture-tiny.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Skill-derived tendency golden fixture (emitted by tools/tendency_oracle.py,
         LOCKED SPEC 2026-07-04), copied beside the binary so RunTendencyGoldenParity
         reads it from AppContext.BaseDirectory (the Phase 53 convention). -->
    <None Include="..\..\tools\tendency_golden.json" Link="tools\tendency_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Roll G displacement golden fixture (emitted by tools/displacement_oracle.py,
         LOCKED SPEC ORACLE v1, 2026-07-04), copied beside the binary so the Phase 56
         golden parity reads it from AppContext.BaseDirectory (same convention). -->
    <None Include="..\..\tools\displacement_golden.json" Link="tools\displacement_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\fastbreak_golden.json" Link="tools\fastbreak_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
