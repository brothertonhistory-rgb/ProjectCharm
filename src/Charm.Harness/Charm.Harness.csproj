<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Charm.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Charm.Engine\Charm.Engine.csproj" />
    <!-- S89: identity types, the allocator and the history file. The harness
         references it; it references nothing. That direction is what makes the
         raw-value seam real — see Charm.History.csproj's header. -->
    <ProjectReference Include="..\Charm.History\Charm.History.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- World Structure Pass 1 (Phase 53) inputs: the committed reference csvs and the
         tiny fixture world, copied beside the binary so the suite reads them from
         AppContext.BaseDirectory (the config.json convention). -->
    <None Include="..\..\data\teams.csv" Link="data\teams.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\data\conf.csv" Link="data\conf.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\worlds\fixture-tiny.world.json" Link="worlds\fixture-tiny.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S92 — the stock world itself, so Phase 83 can compare the COMMITTED BYTES against
         what the converter and the canonical writer produce. Phase 53 has always rebuilt
         this world from the csvs in memory; that proves the converter agrees with itself
         and says nothing about whether the file on disk is still the same world. -->
    <None Include="..\..\worlds\stock-d1.world.json" Link="worlds\stock-d1.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S92 — the authored place table. ONE authoritative file: every campus city plus
         both of R2's hand-maintained lists, each with its permanent PlaceId. The collapse
         rule ran ONCE, by hand, into this file and is never executed at load. -->
    <None Include="..\..\data\places.csv" Link="data\places.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S92 — a retained schemaVersion 1 world, kept for exactly one purpose: to prove that
         the v1 refusal fires and names itself. Do NOT migrate this file; migrating it is
         the same as deleting the check. -->
    <None Include="..\..\worlds\fixture-v1-retired.world.json" Link="worlds\fixture-v1-retired.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S92 — the canonical-BYTES golden. Its places carry the values that expose a
         formatting rule: an integer-valued coordinate, a short decimal, a value needing many
         significant digits, one that emits in exponent notation, and a normalised zero.
         "A second write is byte-identical" only proves self-consistency; THIS file is what
         pins the rule. -->
    <None Include="..\..\worlds\fixture-format.world.json" Link="worlds\fixture-format.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S93 — the conference-slate fixture. The tiny fixture CANNOT test this session: its
         four five-team leagues at 16 games meet every pair exactly four times, so it has
         zero unbalanced games and cannot exercise the orientation at all. This world is
         built to have the awkward shapes — an odd-sized league that skips, a league with
         no doubles but real skips, a two-school league, an idle league, and five rivalries
         including two dormant ones. -->
    <None Include="..\..\worlds\fixture-schedule.world.json" Link="worlds\fixture-schedule.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S96 — the host-memory fixture, and it exists for the same reason fixture-schedule
         did. The TINY fixture cannot test this session either: its five-team leagues at 16
         games meet every pair exactly four times, so no pair is ever odd, no residual ever
         exists, and there is nothing for memory to flip. And fixture-schedule cannot PLAY a
         season at all — its two-school league is refused by the date layer — while a career
         lifecycle check must schedule, play and finalize real seasons to produce the logs it
         then reads back. So: four five-team leagues at SIX games. Every pair meets once or
         twice, twenty pairs across the world meet an odd number of times, every school is
         owed exactly one residual, and a whole season is sixty games. Derived from
         fixture-tiny and written through `world rewrite`, so it is canonical bytes. -->
    <None Include="..\..\worlds\fixture-mte.world.json" Link="worlds\fixture-mte.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\worlds\fixture-v4-retired.world.json" Link="worlds\fixture-v4-retired.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\worlds\fixture-memory.world.json" Link="worlds\fixture-memory.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S99 — the rotation rigs. Two leagues in one file: a five-school league at six games
         (four opponents, two second meetings — the same 2-to-1 ratio as the Sun Belt, and
         small enough that every legal extra graph can be enumerated by brute force), and a
         sixteen-school league at eighteen games, which is the stock Big East's shape exactly:
         fifteen opponents, three second meetings, one full turn through the league in five
         seasons. The deep one is the only rig that can show the eight-season window is deep
         enough, and it is a NEW file precisely so no existing fingerprint moves. -->
    <None Include="..\..\worlds\fixture-rotation.world.json" Link="worlds\fixture-rotation.world.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S92 — the distance golden. Expected miles are computed OUTSIDE .NET from the exact
         serialized coordinates using the spherical haversine form and the exact radius
         3958.7613: an independent IMPLEMENTATION OF THE SAME MODEL, which is the only kind
         of independence that means anything here. An online calculator is NOT an acceptable
         source — ellipsoidal geodesics differ by up to ~0.5%, twenty-plus miles on the long
         pairs, and would fail a correct implementation for the right-looking reason. -->
    <None Include="..\..\tools\geo_distance_golden.json" Link="tools\geo_distance_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Skill-derived tendency golden fixture (emitted by tools/tendency_oracle.py,
         LOCKED SPEC 2026-07-04), copied beside the binary so RunTendencyGoldenParity
         reads it from AppContext.BaseDirectory (the Phase 53 convention). -->
    <None Include="..\..\tools\tendency_golden.json" Link="tools\tendency_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Roll G displacement golden fixture (emitted by tools/displacement_oracle.py,
         LOCKED SPEC ORACLE v1, 2026-07-04), copied beside the binary so the Phase 56
         golden parity reads it from AppContext.BaseDirectory (same convention). -->
    <None Include="..\..\tools\displacement_golden.json" Link="tools\displacement_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\fastbreak_golden.json" Link="tools\fastbreak_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Height-over-defender golden fixture (emitted by tools/height_over_defender_oracle.py,
         LOCKED constants signed Session 54, make%% column regenerated against the live
         recentered curve Session 55), copied beside the binary so the Phase 61 golden
         parity reads it from AppContext.BaseDirectory (same convention). -->
    <None Include="..\..\tools\height_over_defender_golden.json" Link="tools\height_over_defender_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\unforced_turnover_golden.json" Link="tools\unforced_turnover_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- PostMoves interior assist-discount golden fixture (emitted by tools/post_assist_oracle.py,
         S57), copied beside the binary so the Phase 63 golden parity reads it from
         AppContext.BaseDirectory (same convention as the other fixtures above). -->
    <None Include="..\..\tools\post_assist_golden.json" Link="tools\post_assist_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Steal-forcing floor golden fixture (emitted by tools/steal_floor_oracle.py, S58),
         copied beside the binary so the Phase 64 golden parity reads it from
         AppContext.BaseDirectory (same convention). -->
    <None Include="..\..\tools\steal_floor_golden.json" Link="tools\steal_floor_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Perimeter-defense drive-gate golden fixture (emitted by tools/drive_gate_oracle.py,
         S59), copied beside the binary so the Phase 65 golden parity reads it from
         AppContext.BaseDirectory (same convention). -->
    <None Include="..\..\tools\drive_gate_golden.json" Link="tools\drive_gate_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Usage-relief golden fixture (emitted by tools/usage_relief_oracle.py, S60),
         copied beside the binary so the Phase 66 golden parity reads it from
         AppContext.BaseDirectory (same convention). -->
    <None Include="..\..\tools\usage_relief_golden.json" Link="tools\usage_relief_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Discipline make-% shave golden fixture (emitted by tools/discipline_shave_oracle.py,
         S61), copied beside the binary so the Phase 67 golden parity reads it from
         AppContext.BaseDirectory (same convention). -->
    <None Include="..\..\tools\discipline_shave_golden.json" Link="tools\discipline_shave_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Non-shooting (reach-in) foul golden fixture (emitted by tools/nonshooting_foul_oracle.py,
         S62), copied beside the binary so Phase 68 can replay it. -->
    <!-- Block help-arm + credit golden fixture (emitted by tools/block_help_oracle.py,
         LOCKED SPEC 2026-07-27, S79), read by Phase74BlockHelpCheck. -->
    <None Include="..\..\tools\block_help_golden.json" Link="tools\block_help_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S81.3 — the two fixtures that keep block CREDIT a regression test rather than a
         snapshot. block_credit_neutral_frozen.json holds the neutral credit vectors copied
         byte-for-byte from the pre-S81.3 golden and is NEVER regenerated; the oracle reads
         it, proves it still reproduces, and embeds it. block_credit_preedit_golden.json is
         the independent C# emission taken from production BEFORE the edit, stored as raw
         bits — a hand transcription can repeat the same misreading as the new code, so the
         pre-edit emission is what binds the actual old behaviour. -->
    <None Include="..\..\tools\block_credit_neutral_frozen.json" Link="tools\block_credit_neutral_frozen.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\block_credit_preedit_golden.json" Link="tools\block_credit_preedit_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\nonshooting_foul_golden.json" Link="tools\nonshooting_foul_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Pass-3 two-plane budget generation replay fixture (emitted by the oracle's
         fixture switch in tools/gen_pass3_budget_oracle.py). REGENERATED AND RENAMED at
         S78: the CONTRACT changed, not just the values — 61 main slots instead of 68,
         plus a separate 4-slot isolated intangibles block — so the s69 name would have
         been a lie about the shape. The s69 file is retired; journal S69/S71 and git
         history hold the old population. -->
    <!-- Transition opportunity/bar golden fixture (S86). This is the LOCKED oracle's own
         golden-emit output, byte for byte. Regenerate by running
         tools/transition_opportunity_oracle.py with its golden-emit flag and redirecting
         stdout to tools/transition_opportunity_golden.txt (the flag is named in the
         Phase 77 check's B1 comment). -->
    <None Include="..\..\tools\transition_opportunity_golden.txt" Link="tools\transition_opportunity_golden.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\gen_pass3_replay_fixture_s78.json" Link="tools\gen_pass3_replay_fixture_s78.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S89 — the history file's canonical v1 form, pinned. This is a FORMAT fixture, not
         a behaviour one: it is what a brand-new history looks like on disk, byte for byte,
         with a placeholder world fingerprint. It exists so that a later session cannot
         change the key order, the indent, the encoding or the trailing newline of a save
         file without the suite saying so out loud. -->
    <None Include="..\..\tools\history_v1_golden.json" Link="tools\history_v1_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\history_v2_golden.json" Link="tools\history_v2_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- S88's two fixtures. S88 wrote them, and wrote the checks that read them, but never
         added them here — so Phase 79 could not have passed even if it had been registered.
         Added at S89.1 alongside registering the phase itself. -->
    <None Include="..\..\tools\transition_defense_golden.json" Link="tools\transition_defense_golden.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\tools\transition_scope_frozen_s88.json" Link="tools\transition_scope_frozen_s88.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
